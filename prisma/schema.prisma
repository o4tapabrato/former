datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surveys   Survey[]
}

// Flexible Document Model for Surveys & Dynamic Questions
model Survey {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Storing questions as an embedded JSON structure/array 
  // This allows infinite flexibility for any question type without complex table joins
  questions   Question[] 
}

// Embedded type for questions (No separate table needed)
type Question {
  id          String       @default(uuid())
  type        QuestionType
  text        String
  order       Int          @default(0)
  options     String[]     // Simple array of strings for options (e.g., ["Python", "R", "Julia", "SQL"])
  required    Boolean      @default(false)
}

enum QuestionType {
  MULTIPLE_CHOICE
  CHECKBOX
  TEXT
  RATING
}