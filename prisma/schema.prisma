datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surveys   Survey[]
}

model Survey {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  createdAt   DateTime         @default(now())
  expiresAt   DateTime?
  updatedAt   DateTime         @updatedAt
  userId      String           @db.ObjectId
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  questions   SurveyQuestion[] // Relation handled entirely by surveyId on the child side
}

model SurveyQuestion {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  surveyId    String            @db.ObjectId // Foreign key pointing to Survey
  survey      Survey            @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  
  type        SurveyQuestionType
  text        String
  order       Int               @default(0)
  required    Boolean           @default(false)
  options     String[]          
  imageUrl    String?           
  maxRating   Int?              
}

model SurveyResponse {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  surveyId  String   @db.ObjectId // Indexed foreign key
  answers   Json     
  createdAt DateTime @default(now())

  @@index([surveyId])
}

enum SurveyQuestionType {
  MULTIPLE_CHOICE
  CHECKBOX
  TEXT
  RATING
  IMAGE_CHOICE
}