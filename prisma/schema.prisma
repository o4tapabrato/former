datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surveys   Survey[]
}

model Survey {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Store only the references/IDs pointing to the Question collection
  questionIds String[] @db.ObjectId
}

model Question {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  type        QuestionType
  text        String
  order       Int          @default(0)
  options     String[]     
  required    Boolean      @default(false)
  imageUrl    String?      
  maxRating   Int?         
  
  surveyId    String       @db.ObjectId
}

enum QuestionType {
  MULTIPLE_CHOICE
  CHECKBOX
  TEXT
  RATING
}